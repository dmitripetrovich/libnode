+
+void InterruptNativeWork(v8::Isolate* isolate, bool interrupted) {
+  std::lock_guard<std::mutex> lock(NativeInterruptMutex());
+  if (interrupted) {
+    if (NativeInterruptedIsolates().insert(isolate).second) {
+      native_interrupt_count++;
+    }
+  } else if (NativeInterruptedIsolates().erase(isolate) != 0) {
+    native_interrupt_count--;
+  }
+}
+
+bool IsNativeWorkInterrupted(v8::Isolate* isolate) {
+  if (native_interrupt_count.load(std::memory_order_relaxed) == 0) {
+    return false;
+  }
+  std::lock_guard<std::mutex> lock(NativeInterruptMutex());
+  return NativeInterruptedIsolates().count(isolate) != 0;
+}
 
