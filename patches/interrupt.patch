+std::mutex& NativeInterruptMutex() {
+  static std::mutex* mutex = new std::mutex();
+  return *mutex;
+}
+
+std::unordered_set<v8::Isolate*>& NativeInterruptedIsolates() {
+  static std::unordered_set<v8::Isolate*>* isolates =
+      new std::unordered_set<v8::Isolate*>();
+  return *isolates;
+}
